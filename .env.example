SALON_PRO_SECRET_KEY=replace-with-a-long-random-secret
SALON_PRO_ADMIN_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=sqlite:///salon.db
# Use 1 for HTTPS deployments. Production also forces this setting on.
SESSION_COOKIE_SECURE=0
FLASK_ENV=development
PORT=5000

# Salon Pro billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SALON_PRO_MONTHLY_PRICE_INR=499
SALON_PRO_BILLING_REQUIRED=1
SALON_PRO_LEGACY_TRIAL_DAYS=30
